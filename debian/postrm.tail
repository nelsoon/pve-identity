PVE_IDENTITY_INTEGRATE_EOF
    rm -f "$PREFIX/var/lib/pve-identity/changed"
    if [ -z "$PREFIX" ] && [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl try-restart pvedaemon.service pveproxy.service >/dev/null 2>&1 || true
    fi
fi
if [ "$1" = "purge" ]; then
    rm -f "$PREFIX/etc/pve/identity/issuers.d/pve.json"
    rm -f "$PREFIX/var/lib/pve-identity/integration.status"
    rmdir "$PREFIX/var/lib/pve-identity" 2>/dev/null || true
fi
exit 0
